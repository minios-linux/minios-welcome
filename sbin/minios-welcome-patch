#!/bin/sh
set -e

MARKER='// BEGIN MINIOS-WELCOME'
FIREFOX_BRANDING_PATHS='
/usr/share/firefox-esr/browser/defaults/preferences/firefox-branding.js
/etc/firefox/syspref.js
/etc/firefox-esr/syspref.js'

if [ "${1:-}" = "--check" ]; then
    found=0
    for firefox_branding in $FIREFOX_BRANDING_PATHS; do
        [ -f "$firefox_branding" ] || continue
        found=1
        grep -Fqx "$MARKER" "$firefox_branding" || exit 3
    done
    [ "$found" -eq 1 ] || exit 4
    exit 0
elif [ "$#" -ne 0 ]; then
    echo "Usage: minios-welcome-patch [--check]" >&2
    exit 2
fi

DESKTOP_ENVIRONMENT=
[ ! -r /etc/minios/config ] || . /etc/minios/config

for firefox_branding in $FIREFOX_BRANDING_PATHS; do
    if [ ! -f "$firefox_branding" ]; then
        rm -f "${firefox_branding}.bak"
        continue
    fi

    grep -Fqx "$MARKER" "$firefox_branding" && continue

    cp -f "$firefox_branding" "${firefox_branding}.bak"
    {
        echo "$MARKER"
        echo 'pref("startup.homepage_welcome_url", "file:///usr/share/minios/html/index.html");'
        case "${DESKTOP_ENVIRONMENT:-}" in
            *flux*) ;;
            *)
                echo 'pref("browser.tabs.drawInTitlebar", true);'
                echo 'pref("browser.compactmode.show", true);'
                echo 'pref("browser.tabs.inTitlebar", 1);'
                ;;
        esac
        echo 'pref("general.smoothScroll", false);'
        echo 'pref("browser.uidensity", 1);'
        echo 'pref("browser.newtabpage.activity-stream.feeds.topsites", false);'
        echo 'pref("browser.toolbars.bookmarks.visibility", "never");'
        echo '// END MINIOS-WELCOME'
    } >>"$firefox_branding"
done
