#!/bin/sh
set -e

case "$1" in
    remove|purge)
        for firefox_branding in \
            /usr/share/firefox-esr/browser/defaults/preferences/firefox-branding.js \
            /etc/firefox/syspref.js \
            /etc/firefox-esr/syspref.js
        do
            [ -f "${firefox_branding}.bak" ] || continue
            if [ -f "$firefox_branding" ] && grep -Fqx '// BEGIN MINIOS-WELCOME' "$firefox_branding"; then
                mv -f "${firefox_branding}.bak" "$firefox_branding"
            else
                rm -f "${firefox_branding}.bak"
            fi
        done
        ;;
esac

#DEBHELPER#
