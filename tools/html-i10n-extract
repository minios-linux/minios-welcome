#!/usr/bin/env python3

import argparse
import json
import os
import sys
from collections import OrderedDict
from html.parser import HTMLParser


TRANSLATABLE_TAGS = {"title", "span", "a", "p", "h1", "h2", "h3", "h4", "h5", "h6"}
VOID_TAGS = {
    "area", "base", "br", "col", "embed", "hr", "img", "input", "link",
    "meta", "param", "source", "track", "wbr",
}


class TextExtractor(HTMLParser):
    def __init__(self):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.stack = []
        self.entries = OrderedDict()

    def handle_starttag(self, tag, attrs):
        if tag not in VOID_TAGS:
            self.stack.append(tag)

    def handle_startendtag(self, tag, attrs):
        pass

    def handle_endtag(self, tag):
        for index in range(len(self.stack) - 1, -1, -1):
            if self.stack[index] == tag:
                del self.stack[index:]
                break

    def handle_data(self, data):
        if not self.stack or self.stack[-1] not in TRANSLATABLE_TAGS:
            return
        if "svg" in self.stack:
            return

        key = data.strip()
        if not key or key in {".", "*"}:
            return

        value = key
        if data[:1].isspace():
            value = " " + value
        if data[-1:].isspace():
            value += " "
        self.entries.setdefault(key, value)


def load_catalog(path):
    if not os.path.exists(path):
        return OrderedDict()

    with open(path, "r", encoding="utf-8") as catalog_file:
        contents = catalog_file.read()

    prefix = "window.translations = "
    if not contents.startswith(prefix) or not contents.rstrip().endswith("};"):
        raise ValueError("{} is not a window.translations catalog".format(path))

    payload = contents[len(prefix):].rstrip()[:-1]
    catalog = json.loads(payload, object_pairs_hook=OrderedDict)
    if not isinstance(catalog, dict):
        raise ValueError("{} does not contain a translation object".format(path))
    return catalog


def render_catalog(entries, existing):
    catalog = OrderedDict()
    for key, source_value in entries.items():
        catalog[key] = existing.get(key, source_value)
    payload = json.dumps(catalog, ensure_ascii=False, indent=4)
    return "window.translations = {};\n".format(payload)


def synchronize(input_path, output_path, check):
    with open(input_path, "r", encoding="utf-8") as html_file:
        contents = html_file.read()
    if not contents:
        raise ValueError("{} is empty".format(input_path))

    extractor = TextExtractor()
    extractor.feed(contents)
    extractor.close()

    existing = load_catalog(output_path)
    rendered = render_catalog(extractor.entries, existing)
    current = ""
    if os.path.exists(output_path):
        with open(output_path, "r", encoding="utf-8") as catalog_file:
            current = catalog_file.read()

    if rendered == current:
        return False
    if check:
        return True

    temporary_path = output_path + ".tmp"
    with open(temporary_path, "w", encoding="utf-8") as catalog_file:
        catalog_file.write(rendered)
    os.replace(temporary_path, output_path)
    return True


def main():
    parser = argparse.ArgumentParser(
        description="Synchronize the MiniOS welcome English JS catalog with HTML text."
    )
    parser.add_argument("--input", default="html/index.html", help="source HTML file")
    parser.add_argument(
        "--output",
        default="html/js/translations/en.js",
        help="window.translations JS catalog",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="report a stale catalog without modifying it",
    )
    args = parser.parse_args()

    try:
        changed = synchronize(args.input, args.output, args.check)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print("html-i10n-extract: {}".format(error), file=sys.stderr)
        return 2

    if changed and args.check:
        print("{} is not synchronized with {}".format(args.output, args.input), file=sys.stderr)
        return 1
    if changed:
        print("Synchronized {} with {}".format(args.output, args.input))
    return 0


if __name__ == "__main__":
    sys.exit(main())
