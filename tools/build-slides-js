#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

if ! command -v terser >/dev/null 2>&1; then
    echo "terser is required to rebuild html/js/slides.min.js" >&2
    exit 1
fi

terser html/js/plugins.js html/js/slides.js \
    --ecma 5 --compress --mangle --comments \
    --output html/js/slides.min.js
