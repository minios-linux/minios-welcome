#. type: Plain text
#: en/minios-welcome-patch.8:4
msgid "minios-welcome-patch - configure the Firefox MiniOS welcome page"
msgstr ""
"minios-welcome-patch — настройка стартовой страницы приветствия Firefox "
"MiniOS"

#. type: SH
#: en/minios-welcome-patch.8:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "СИНТАКСИС"

#. type: Plain text
#: en/minios-welcome-patch.8:7
msgid "B<minios-welcome-patch> [B<--check>]"
