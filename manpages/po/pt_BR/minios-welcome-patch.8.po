msgid "DESCRIPTION"
msgstr "DESCRIÇÃO"

#. type: Plain text
#: en/minios-welcome-patch.8:14
msgid ""
"B<minios-welcome-patch> adds a managed block of MiniOS preferences to each "
"supported Firefox system configuration file. Before changing a file, it "
"stores the unmodified contents in a file with the B<.bak> suffix. Repeated "
"invocations do not duplicate the managed block."
msgstr ""
"B<minios-welcome-patch> adiciona um bloco gerenciado de preferências MiniOS "
"em cada arquivo de configuração de sistema do Firefox suportado. Antes de "
"alterar um arquivo, o conteúdo original é salvo em um arquivo com o sufixo "
"B<.bak>. Execuções repetidas não duplicam o bloco gerenciado."

#. type: Plain text
#: en/minios-welcome-patch.8:17
msgid "Desktop-specific preferences are selected using B</etc/minios/config>."
msgstr ""
"As preferências específicas para o ambiente de trabalho são selecionadas "
"utilizando B</etc/minios/config>."

#. type: SH
#: en/minios-welcome-patch.8:17
#, no-wrap
msgid "OPTIONS"
msgstr "OPÇÕES"

#. type: TP
#: en/minios-welcome-patch.8:18
#, no-wrap
msgid "B<--check>"
msgstr "B<--check>"

#. type: Plain text
#: en/minios-welcome-patch.8:23
msgid ""
"Exit with status 0 when every existing supported Firefox configuration file "
"contains the MiniOS managed block. Exit with status 3 when an existing file "
"is not configured, or 4 when no supported configuration file exists."
msgstr ""
"Sai com status 0 quando todos os arquivos de configuração do Firefox "
"suportados existentes contêm o bloco gerenciado MiniOS. Sai com status 3 "
"quando um arquivo existente não está configurado, ou 4 quando não existe "
"nenhum arquivo de configuração suportado."

#. type: SH
#: en/minios-welcome-patch.8:23
#, no-wrap
msgid "FILES"
msgstr "ARQUIVOS"

#. type: TP
#: en/minios-welcome-patch.8:24
#, no-wrap
msgid "B</etc/minios/config>"
msgstr "B</etc/minios/config>"

#. type: Plain text
#: en/minios-welcome-patch.8:27
msgid "MiniOS system configuration."
msgstr "Configuração do sistema MiniOS."

#. type: TP
#: en/minios-welcome-patch.8:27
#, no-wrap
msgid "B</usr/share/minios/html/index.html>"
msgstr "B</usr/share/minios/html/index.html>"

#. type: Plain text
